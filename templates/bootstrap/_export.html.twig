{% set export_formats = options.exportFormats is defined ? options.exportFormats : ['csv'] %}
{% set export_urls = options.exportUrls %}

<div class="dropdown zhortein-datatable__export">
    <button
        class="btn btn-sm btn-outline-secondary dropdown-toggle d-inline-flex align-items-center gap-1"
        type="button"
        data-bs-toggle="dropdown"
        aria-expanded="false"
    >
        {{ zhortein_datatable_icon(export_icon) }}
        {{ 'zhortein_datatable.export.label'|trans({}, 'zhortein_datatable') }}
    </button>

    <div class="dropdown-menu">
        {% for export_format in export_formats %}
            {% if export_format in ['csv', 'xlsx'] %}
                {% set format_export_url = export_urls[export_format] %}
                {% set item_icon = export_format == 'csv' ? export_csv_icon : (export_format == 'xlsx' ? export_xlsx_icon : null) %}
                {% set query_separator = '?' in format_export_url ? '&' : '?' %}

                <a
                    class="dropdown-item"
                    href="{{ format_export_url }}{{ query_separator }}mode=current"
                    data-turbo-prefetch="false"
                    data-turbo="false"
                    data-action="zhortein--datatable-bundle--datatable#export"
                    data-zhortein--datatable-bundle--datatable-export-mode-param="current"
                    data-zhortein--datatable-bundle--datatable-export-format-param="{{ export_format }}"
                    data-zhortein--datatable-bundle--datatable-export-url-param="{{ format_export_url }}"
                    data-zhortein--datatable-bundle--datatable-export-mode="current"
                >
                    {{ zhortein_datatable_icon(item_icon) }}
                    {{ ('zhortein_datatable.export.' ~ export_format ~ '_current')|trans({}, 'zhortein_datatable') }}
                </a>
                <a
                    class="dropdown-item"
                    href="{{ format_export_url }}{{ query_separator }}mode=full"
                    data-turbo-prefetch="false"
                    data-turbo="false"
                    data-action="zhortein--datatable-bundle--datatable#export"
                    data-zhortein--datatable-bundle--datatable-export-mode-param="full"
                    data-zhortein--datatable-bundle--datatable-export-format-param="{{ export_format }}"
                    data-zhortein--datatable-bundle--datatable-export-url-param="{{ format_export_url }}"
                    data-zhortein--datatable-bundle--datatable-export-mode="full"
                >
                    {{ zhortein_datatable_icon(item_icon) }}
                    {{ ('zhortein_datatable.export.' ~ export_format ~ '_full')|trans({}, 'zhortein_datatable') }}
                </a>
            {% endif %}
        {% endfor %}
    </div>
</div>
