{% set current_sort_field = options.sortField is defined ? options.sortField : null %}
{% set current_sort_direction = options.sortDirection is defined ? options.sortDirection : 'asc' %}
{% set filter_layout = options.filterLayout is defined ? options.filterLayout : 'toolbar' %}
{% set header_filters_enabled = filter_layout == 'header' %}

<thead data-zhortein--datatable-bundle--datatable-target="header">
    <tr>
        {% if hasBulkActions|default(false) %}
            <th scope="col" class="zhortein-datatable__selector-column">
                <input
                    type="checkbox"
                    class="form-check-input"
                    data-zhortein--datatable-bundle--datatable-target="selectAllCheckbox"
                    data-action="zhortein--datatable-bundle--datatable#selectAll"
                    aria-label="{{ 'zhortein_datatable.bulk_actions.select_all'|trans({}, 'zhortein_datatable') }}"
                >
            </th>
        {% endif %}

        {% for column in visibleColumns %}
            {% set is_current_sort = column.name == current_sort_field %}
            {% set aria_sort = null %}
            {% set column_filter = null %}
            {% set column_class_name = columnClassNames[column.name]|default(null) %}
            {% set column_label = zhortein_datatable_translate(column.label, definition.translationDomain, column.name) %}

            {% if is_current_sort %}
                {% set aria_sort = current_sort_direction == 'desc' ? 'descending' : 'ascending' %}
            {% endif %}

            {% if header_filters_enabled and definition.filters is not empty %}
                {% set matching_filters = definition.filters|filter(filter => filter.field == column.name) %}
                {% set column_filter = matching_filters|first %}
            {% endif %}

            <th
                {% if column_class_name is not null %}
                    class="{{ column_class_name }}"
                {% endif %}
                scope="col"
                {% if aria_sort is not null %}
                    aria-sort="{{ aria_sort }}"
                {% endif %}
            >
                <div class="d-inline-flex align-items-center gap-1">
                    {% if column.sortable %}
                        <button
                            type="button"
                            class="btn btn-link p-0 text-decoration-none d-inline-flex align-items-center gap-1 zhortein-datatable__sort-button{% if is_current_sort %} active{% endif %}"
                            data-action="zhortein--datatable-bundle--datatable#sort"
                            data-zhortein--datatable-bundle--datatable-field-param="{{ column.name }}"
                            data-zhortein--datatable-bundle--datatable-current-sort-param="{{ is_current_sort ? 'true' : 'false' }}"
                            data-zhortein--datatable-bundle--datatable-sort-direction-param="{{ is_current_sort ? current_sort_direction : '' }}"
                            aria-label="{{ 'zhortein_datatable.sort.label'|trans({
                                '%column%': column_label
                            }, 'zhortein_datatable') }}"
                        >
                            <span class="zhortein-datatable__sort-label">
                                {{ column_label }}
                            </span>

                            <span class="zhortein-datatable__sort-indicator text-body-secondary" aria-hidden="true">
                                {% if is_current_sort and current_sort_direction == 'desc' %}
                                    {% if sort_desc is not empty %}<i class="{{ sort_desc }}"></i>{% else %}↓{% endif %}
                                {% elseif is_current_sort %}
                                    {% if sort_asc is not empty %}<i class="{{ sort_asc }}"></i>{% else %}↑{% endif %}
                                {% else %}
                                    {% if sort_neutral is not empty %}<i class="{{ sort_neutral }}"></i>{% else %}↕{% endif %}
                                {% endif %}
                            </span>

                            {% if is_current_sort %}
                                <span class="visually-hidden">
                                    {{ current_sort_direction == 'desc' ? 'zhortein_datatable.sort.sorted_descending'|trans({}, 'zhortein_datatable') : 'zhortein_datatable.sort.sorted_ascending'|trans({}, 'zhortein_datatable') }}
                                </span>
                            {% endif %}
                        </button>
                    {% else %}
                        <span>{{ column_label }}</span>
                    {% endif %}

                    {% if column_filter %}
                        {% include '@ZhorteinDatatable/bootstrap/_column_filter.html.twig' with {
                            column: column,
                            filter: column_filter,
                            columnLabel: column_label,
                            htmlId: htmlId,
                            filters: filters|default({}),
                            translationDomain: definition.translationDomain
                        } %}
                    {% endif %}
                </div>
            </th>
        {% endfor %}

        {% if hasRowActions %}
            <th class="text-end" scope="col">
                {{ 'zhortein_datatable.actions.label'|trans({}, 'zhortein_datatable') }}
            </th>
        {% endif %}
    </tr>
</thead>
