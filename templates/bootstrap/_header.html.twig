<thead>
    <tr>
        {% for column in visibleColumns %}
            <th{% if column.className is not null %} class="{{ column.className }}"{% endif %} scope="col">
                {% if column.sortable %}
                    <button
                        type="button"
                        class="btn btn-link p-0 text-decoration-none"
                        data-action="zhortein-datatable#sort"
                        data-zhortein-datatable-field-param="{{ column.name }}"
                    >
                        {{ column.label ?? column.name }}
                    </button>
                {% else %}
                    {{ column.label ?? column.name }}
                {% endif %}
            </th>
        {% endfor %}

        {% if hasRowActions %}
            <th class="text-end" scope="col">
                {{ 'zhortein_datatable.actions'|trans({}, 'zhortein_datatable') }}
            </th>
        {% endif %}
    </tr>
</thead>
