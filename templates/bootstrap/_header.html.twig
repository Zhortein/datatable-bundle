{% set current_sort_field = options.sortField is defined ? options.sortField : null %}
{% set current_sort_direction = options.sortDirection is defined ? options.sortDirection : 'asc' %}

<thead>
    <tr>
        {% for column in visibleColumns %}
            {% set is_current_sort = column.name == current_sort_field %}
            <th
                {% if column.className is not null %}
                    class="{{ column.className }}"
                {% endif %}
                scope="col"
                {% if is_current_sort %}
                    aria-sort="{{ current_sort_direction == 'desc' ? 'descending' : 'ascending' }}"
                {% endif %}
            >
                {% if column.sortable %}
                    <button
                        type="button"
                        class="btn btn-link p-0 text-decoration-none{% if is_current_sort %} active{% endif %}"
                        data-action="zhortein-datatable#sort"
                        data-zhortein-datatable-field-param="{{ column.name }}"
                        data-zhortein-datatable-current-sort-param="{{ is_current_sort ? 'true' : 'false' }}"
                        data-zhortein-datatable-sort-direction-param="{{ is_current_sort ? current_sort_direction : '' }}"
                        aria-label="{{ 'zhortein_datatable.sort.label'|trans({
                            '%column%': column.label ?? column.name
                        }, 'zhortein_datatable') }}"
                    >
                        {{ column.label ?? column.name }}

                        {% if is_current_sort %}
                            <span class="visually-hidden">
                                {{ current_sort_direction == 'desc' ? 'zhortein_datatable.sort.sorted_descending'|trans({}, 'zhortein_datatable') : 'zhortein_datatable.sort.sorted_ascending'|trans({}, 'zhortein_datatable') }}
                            </span>
                        {% endif %}
                    </button>
                {% else %}
                    {{ column.label ?? column.name }}
                {% endif %}
            </th>
        {% endfor %}

        {% if hasRowActions %}
            <th class="text-end" scope="col">
                {{ 'zhortein_datatable.actions'|trans({}, 'zhortein_datatable') }}
            </th>
        {% endif %}
    </tr>
</thead>
