{% set pagination_size = options.paginationSize|default('default') %}
{% set pagination_classes = ['pagination', 'mb-0'] %}

{% if pagination_size == 'sm' %}
    {% set pagination_classes = pagination_classes|merge(['pagination-sm']) %}
{% elseif pagination_size == 'lg' %}
    {% set pagination_classes = pagination_classes|merge(['pagination-lg']) %}
{% endif %}

<div
    class="zhortein-datatable__pagination"
    data-zhortein--datatable-bundle--datatable-target="pagination"
>
    {% if result is defined and result is not null and result.totalPages > 1 %}
        <nav aria-label="{{ 'zhortein_datatable.pagination.label'|trans({}, 'zhortein_datatable') }}">
            <ul class="{{ pagination_classes|join(' ') }}">
                <li class="page-item{% if result.page <= 1 %} disabled{% endif %}">
                    <button
                        type="button"
                        class="page-link"
                        data-action="zhortein--datatable-bundle--datatable#goToPage"
                        data-zhortein--datatable-bundle--datatable-page-param="{{ result.page - 1 }}"
                        aria-label="{{ 'zhortein_datatable.pagination.previous'|trans({}, 'zhortein_datatable') }}"
                        {% if result.page <= 1 %}disabled aria-disabled="true"{% endif %}
                    >
                        {{ zhortein_datatable_icon_key('pagination_previous', {class: 'me-1'}) }}
                        <span>{{ 'zhortein_datatable.pagination.previous'|trans({}, 'zhortein_datatable') }}</span>
                    </button>
                </li>

                {% for page in 1..result.totalPages %}
                    <li class="page-item{% if page == result.page %} active{% endif %}">
                        <button
                            type="button"
                            class="page-link"
                            data-action="zhortein--datatable-bundle--datatable#goToPage"
                            data-zhortein--datatable-bundle--datatable-page-param="{{ page }}"
                            aria-label="{{ 'zhortein_datatable.pagination.page'|trans({
                                '%page%': page
                            }, 'zhortein_datatable') }}"
                            {% if page == result.page %}aria-current="page"{% endif %}
                        >
                            {{ page }}
                        </button>
                    </li>
                {% endfor %}

                <li class="page-item{% if result.page >= result.totalPages %} disabled{% endif %}">
                    <button
                        type="button"
                        class="page-link"
                        data-action="zhortein--datatable-bundle--datatable#goToPage"
                        data-zhortein--datatable-bundle--datatable-page-param="{{ result.page + 1 }}"
                        aria-label="{{ 'zhortein_datatable.pagination.next'|trans({}, 'zhortein_datatable') }}"
                        {% if result.page >= result.totalPages %}disabled aria-disabled="true"{% endif %}
                    >
                        <span>{{ 'zhortein_datatable.pagination.next'|trans({}, 'zhortein_datatable') }}</span>
                        {{ zhortein_datatable_icon_key('pagination_next', {class: 'ms-1'}) }}
                    </button>
                </li>
            </ul>
        </nav>
    {% endif %}
</div>
