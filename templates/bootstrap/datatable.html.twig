{% set fragments_url = options.fragmentsUrl %}
{% set export_url = options.exportUrl %}
{% set page_size = options.pageSize|default(25) %}
{% set sort_field = options.sortField|default('') %}
{% set sort_direction = options.sortDirection|default('asc') %}
{% set sorts = options.sorts|default([]) %}
{% set auto_load = options.autoLoad is defined ? options.autoLoad : true %}
{% set search_builder = options.searchBuilder is defined ? options.searchBuilder : false %}
{% set controls_layout = options.controlsLayout|default('default') %}
{% set table_striped = options.tableStriped is defined ? options.tableStriped : true %}
{% set table_hover = options.tableHover is defined ? options.tableHover : true %}
{% set table_bordered = options.tableBordered is defined ? options.tableBordered : false %}
{% set table_borderless = options.tableBorderless is defined ? options.tableBorderless : false %}
{% set table_small = options.tableSmall is defined ? options.tableSmall : false %}
{% set pagination_size = options.paginationSize|default(table_small ? 'sm' : 'default') %}
{% set table_responsive = options.tableResponsive is defined ? options.tableResponsive : true %}
{% set table_classes = ['table', 'align-middle', 'mb-0'] %}
{% set root_class = options.rootClass|default('')|trim %}
{% set table_wrapper_class = options.tableWrapperClass|default('')|trim %}
{% set table_class = options.tableClass|default('')|trim %}
{% set confirmation_modal_enabled = options.confirmationModal is defined ? options.confirmationModal : true %}
{% set filter_layout = options.filterLayout|default('toolbar') %}
{% set boolean_display_mode = options.booleanDisplayMode|default('badge') %}

{% if table_striped %}
    {% set table_classes = table_classes|merge(['table-striped']) %}
{% endif %}

{% if table_hover %}
    {% set table_classes = table_classes|merge(['table-hover']) %}
{% endif %}

{% if table_bordered %}
    {% set table_classes = table_classes|merge(['table-bordered']) %}
{% endif %}

{% if table_borderless %}
    {% set table_classes = table_classes|merge(['table-borderless']) %}
{% endif %}

{% if table_small %}
    {% set table_classes = table_classes|merge(['table-sm']) %}
{% endif %}

{% if table_class is not empty %}
    {% set table_classes = table_classes|merge([table_class]) %}
{% endif %}

{% set table_wrapper_classes = [] %}

{% if table_responsive %}
    {% set table_wrapper_classes = table_wrapper_classes|merge(['table-responsive']) %}
{% endif %}

{% if table_wrapper_class is not empty %}
    {% set table_wrapper_classes = table_wrapper_classes|merge([table_wrapper_class]) %}
{% endif %}

<div
    id="{{ htmlId }}"
    class="zhortein-datatable{% if root_class is not empty %} {{ root_class }}{% endif %}"
    data-controller="zhortein--datatable-bundle--datatable"
    data-zhortein--datatable-bundle--datatable-name-value="{{ definition.name }}"
    data-zhortein--datatable-bundle--datatable-instance-value="{{ options.instance }}"
    {% if options.stateParameter is defined %}
        data-zhortein--datatable-bundle--datatable-state-parameter-value="{{ options.stateParameter }}"
    {% endif %}
    {% if options.savedViewsUrl is defined %}
        data-zhortein--datatable-bundle--datatable-saved-views-url-value="{{ options.savedViewsUrl }}"
        data-zhortein--datatable-bundle--datatable-saved-views-csrf-token-value="{{ options.savedViewsCsrfToken }}"
        data-zhortein--datatable-bundle--datatable-saved-views-include-page-value="{{ options.savedViewsIncludePage ? 'true' : 'false' }}"
        data-zhortein--datatable-bundle--datatable-saved-view-default-suffix-value="{{ 'zhortein_datatable.saved_views.default_suffix'|trans({}, 'zhortein_datatable') }}"
        data-zhortein--datatable-bundle--datatable-saved-view-delete-confirmation-value="{{ 'zhortein_datatable.saved_views.delete_confirmation'|trans({}, 'zhortein_datatable') }}"
        data-zhortein--datatable-bundle--datatable-saved-view-success-message-value="{{ 'zhortein_datatable.saved_views.success'|trans({}, 'zhortein_datatable') }}"
        data-zhortein--datatable-bundle--datatable-saved-view-error-message-value="{{ 'zhortein_datatable.saved_views.error'|trans({}, 'zhortein_datatable') }}"
        data-zhortein--datatable-bundle--datatable-saved-view-conflict-message-value="{{ 'zhortein_datatable.saved_views.conflict'|trans({}, 'zhortein_datatable') }}"
    {% endif %}
    data-zhortein--datatable-bundle--datatable-fragments-url-value="{{ fragments_url }}"
    data-zhortein--datatable-bundle--datatable-export-url-value="{{ export_url }}"
    data-zhortein--datatable-bundle--datatable-page-value="1"
    data-zhortein--datatable-bundle--datatable-page-size-value="{{ page_size }}"
    data-zhortein--datatable-bundle--datatable-sort-field-value="{{ sort_field }}"
    data-zhortein--datatable-bundle--datatable-sort-direction-value="{{ sort_direction }}"
    data-zhortein--datatable-bundle--datatable-sorts-value="{{ sorts|json_encode|e('html_attr') }}"
    data-zhortein--datatable-bundle--datatable-auto-load-value="{{ auto_load ? 'true' : 'false' }}"
    data-zhortein--datatable-bundle--datatable-filter-layout-value="{{ filter_layout }}"
    data-zhortein--datatable-bundle--datatable-search-builder-value="{{ search_builder ? 'true' : 'false' }}"
    data-zhortein--datatable-bundle--datatable-boolean-display-mode-value="{{ boolean_display_mode }}"
    data-zhortein--datatable-bundle--datatable-pagination-size-value="{{ pagination_size }}"
    data-zhortein--datatable-bundle--datatable-table-small-value="{{ table_small ? 'true' : 'false' }}"
    data-zhortein--datatable-bundle--datatable-action-success-message-value="{{ 'zhortein_datatable.ajax_action.success'|trans({}, 'zhortein_datatable') }}"
    data-zhortein--datatable-bundle--datatable-action-error-message-value="{{ 'zhortein_datatable.ajax_action.error'|trans({}, 'zhortein_datatable') }}"
    data-zhortein--datatable-bundle--datatable-invalid-action-response-message-value="{{ 'zhortein_datatable.ajax_action.invalid_response'|trans({}, 'zhortein_datatable') }}"
    aria-busy="false"
>
    {% include '@ZhorteinDatatable/bootstrap/_toolbar.html.twig' with {
        definition: definition,
        htmlId: htmlId,
        globalActions: globalActions,
        options: options,
        controlsLayout: controls_layout,
        filters: filters|default({})
    } %}

    {% if search_builder %}
        {% include '@ZhorteinDatatable/bootstrap/_search_builder.html.twig' %}
    {% endif %}

    {% include '@ZhorteinDatatable/bootstrap/_bulk_actions.html.twig' with {
        bulkActions: bulkActions|default([])
    } %}

    <div
        class="alert alert-success d-none align-items-center gap-2"
        role="status"
        aria-live="polite"
        aria-hidden="true"
        data-zhortein--datatable-bundle--datatable-target="feedback"
    ></div>

    <div
        class="alert alert-danger d-none align-items-center gap-2"
        role="alert"
        aria-live="polite"
        aria-hidden="true"
        data-zhortein--datatable-bundle--datatable-target="error"
    ></div>

    <div
        class="zhortein-datatable__loading d-none align-items-center gap-2 text-body-secondary small mb-2"
        role="status"
        aria-live="polite"
        aria-hidden="true"
        data-zhortein--datatable-bundle--datatable-target="loading"
    >
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>{{ 'zhortein_datatable.loading'|trans({}, 'zhortein_datatable') }}</span>
    </div>

    <div{% if table_wrapper_classes is not empty %} class="{{ table_wrapper_classes|join(' ') }}"{% endif %}>
        <table class="{{ table_classes|join(' ') }}">
            {% include '@ZhorteinDatatable/bootstrap/_header.html.twig' %}

            <tbody data-zhortein--datatable-bundle--datatable-target="body">
                {% include '@ZhorteinDatatable/bootstrap/_empty.html.twig' %}
            </tbody>
        </table>
    </div>

    {% if controls_layout == 'split' %}
        {% include '@ZhorteinDatatable/bootstrap/_bottom_controls.html.twig' with {
            definition: definition,
            htmlId: htmlId,
            options: options,
            result: result|default(null)
        } only %}
    {% else %}
        <div class="zhortein-datatable__footer d-flex flex-wrap align-items-center justify-content-between gap-3 mt-3">
            <div
                class="zhortein-datatable__summary text-body-secondary small"
                aria-live="polite"
                data-zhortein--datatable-bundle--datatable-target="summary"
            ></div>
            {% include '@ZhorteinDatatable/bootstrap/_pagination.html.twig' %}
        </div>
    {% endif %}

    {% if confirmation_modal_enabled %}
        {% include '@ZhorteinDatatable/bootstrap/_confirmation_modal.html.twig' with {
            htmlId: htmlId
        } only %}
    {% endif %}
</div>
