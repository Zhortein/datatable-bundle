{% set has_icon = action.icon is not null and action.icon is not empty %}
{% set icon_position = action.iconPosition ?? 'before' %}
{% set translation_domain = action.translationDomain|default(null) %}
{% set label = zhortein_datatable_translate(action.label, translation_domain, action.name) %}
{% set confirmation_message = zhortein_datatable_translate(action.confirmationMessage, translation_domain) %}
{% set ajax = action.ajax|default(false) %}
{% set controller_action = ajax ? 'executeAjaxAction' : 'confirmAction' %}

{% if action.httpMethod == 'GET' %}
    <a
        href="{{ action.url }}"
        class="dropdown-item"
        data-turbo-prefetch="false"
        {% if ajax %}
            data-turbo="false"
            data-zhortein--datatable-bundle--datatable-ajax-action="true"
            data-zhortein--datatable-bundle--datatable-ajax-action-name="{{ action.name }}"
            data-zhortein--datatable-bundle--datatable-ajax-success-strategy="{{ action.ajaxSuccessStrategy }}"
        {% endif %}
        {% if ajax or action.confirmationMessage is not null %}
            data-action="click->zhortein--datatable-bundle--datatable#{{ controller_action }}"
        {% endif %}
        {% if action.confirmationMessage is not null %}
            data-zhortein--datatable-bundle--datatable-confirmation-message="{{ confirmation_message }}"
        {% endif %}
        {% for attribute_name, attribute_value in action.attributes %}
            {{ attribute_name }}="{{ attribute_value }}"
        {% endfor %}
    >
        {% if has_icon and icon_position == 'before' %}
            <span class="{{ action.icon }} me-1" aria-hidden="true"></span>
        {% endif %}
        <span>{{ label }}</span>
        {% if has_icon and icon_position == 'after' %}
            <span class="{{ action.icon }} ms-1" aria-hidden="true"></span>
        {% endif %}
    </a>
{% else %}
    <form
        method="post"
        action="{{ action.url }}"
        {% if ajax %}
            data-turbo="false"
            data-zhortein--datatable-bundle--datatable-ajax-action="true"
            data-zhortein--datatable-bundle--datatable-ajax-action-name="{{ action.name }}"
            data-zhortein--datatable-bundle--datatable-ajax-success-strategy="{{ action.ajaxSuccessStrategy }}"
        {% endif %}
        {% if ajax or action.confirmationMessage is not null %}
            data-action="submit->zhortein--datatable-bundle--datatable#{{ controller_action }}"
        {% endif %}
        {% if action.confirmationMessage is not null %}
            data-zhortein--datatable-bundle--datatable-confirmation-message="{{ confirmation_message }}"
        {% endif %}
    >
        <input type="hidden" name="_method" value="{{ action.httpMethod }}">
        {% if action.csrfToken is not null %}
            <input type="hidden" name="_token" value="{{ action.csrfToken }}">
        {% endif %}
        <button
            type="submit"
            class="dropdown-item"
            {% for attribute_name, attribute_value in action.attributes %}
                {{ attribute_name }}="{{ attribute_value }}"
            {% endfor %}
        >
            {% if has_icon and icon_position == 'before' %}
                <span class="{{ action.icon }} me-1" aria-hidden="true"></span>
            {% endif %}
            <span>{{ label }}</span>
            {% if has_icon and icon_position == 'after' %}
                <span class="{{ action.icon }} ms-1" aria-hidden="true"></span>
            {% endif %}
        </button>
    </form>
{% endif %}
