<td{% if class_name is not null %} class="{{ class_name }}"{% endif %}>
    {% include template with {
        cell: cell|default(null),
        column: column,
        column_label: zhortein_datatable_translate(column.label, translation_domain, column.name),
        translation_domain: translation_domain,
        value: value,
        row: cell is defined ? cell.row : {},
        source: cell is defined ? cell.source : null,
        row_identifier: cell is defined ? cell.rowIdentifier : null,
        datatable: cell is defined ? cell.definition : null,
        datatable_context: cell is defined ? cell.datatableContext : null,
        boolean_display_mode: boolean_display_mode,
        boolean_true_icon: boolean_true_icon,
        boolean_false_icon: boolean_false_icon,
        enum_presentation: enum_presentation|default(null)
    } only %}
</td>
