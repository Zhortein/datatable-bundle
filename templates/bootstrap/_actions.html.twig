{% set resolved_row_action_display_mode = rowActionDisplayMode ?? 'inline' %}

<td class="text-end">
    {% if resolved_row_action_display_mode == 'dropdown' %}
        {% include '@ZhorteinDatatable/bootstrap/_row_actions_dropdown.html.twig' with {
            actions: actions,
            htmlId: htmlId,
            rowIndex: rowIndex
        } only %}
    {% elseif resolved_row_action_display_mode == 'list' %}
        {% include '@ZhorteinDatatable/bootstrap/_row_actions_list.html.twig' with {
            actions: actions
        } only %}
    {% else %}
        {% include '@ZhorteinDatatable/bootstrap/_row_actions_inline.html.twig' with {
            actions: actions
        } only %}
    {% endif %}
</td>