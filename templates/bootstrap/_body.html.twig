{% for row in rows %}
    {% include '@ZhorteinDatatable/bootstrap/_row.html.twig' with {
        row: row,
        htmlId: htmlId,
        rowIndex: loop.index,
        rowActionDisplayMode: rowActionDisplayMode,
        hasBulkActions: hasBulkActions|default(false),
        hasChildDatatable: hasChildDatatable|default(false),
        childColspan: childColspan|default(1)
    } only %}
{% endfor %}
