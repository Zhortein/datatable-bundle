{% set filter_button_id = htmlId ~ '_column_filter_' ~ filter.name %}
{% set filter_label = filter.label ?? column.label ?? column.name %}
{% set is_active = filters[filter.name] is defined and filters[filter.name] is not empty %}

<div
        class="dropdown zhortein-datatable__column-filter"
        data-action="show.bs.dropdown->zhortein--datatable-bundle--datatable#allowDropdownOverflow hidden.bs.dropdown->zhortein--datatable-bundle--datatable#restoreDropdownOverflow"
>
    <button
        type="button"
        class="btn btn-sm btn-link p-0 text-decoration-none zhortein-datatable__column-filter-toggle{% if is_active %} active text-primary fw-bold{% endif %}"
        id="{{ filter_button_id }}"
        data-bs-toggle="dropdown"
        data-bs-auto-close="outside"
        data-action="click->zhortein--datatable-bundle--datatable#stopProp"
        aria-expanded="false"
        aria-label="{{ 'zhortein_datatable.filters.column_filter'|trans({
            '%column%': filter_label
        }, 'zhortein_datatable') }}"
    >
        {% if is_active and filter_active_icon %}
            <i class="{{ filter_active_icon }}" aria-hidden="true"></i>
        {% elseif filter_icon %}
            <i class="{{ filter_icon }}" aria-hidden="true"></i>
        {% else %}
            <span aria-hidden="true">⌕</span>
        {% endif %}
    </button>

    <div
        class="dropdown-menu p-2 zhortein-datatable__column-filter-menu"
        aria-labelledby="{{ filter_button_id }}"
        style="min-width: 200px;"
    >
        {% include '@ZhorteinDatatable/bootstrap/_filter.html.twig' with {
            filter: filter,
            htmlId: htmlId,
            value: filters[filter.name]|default(null)
        } only %}

        {% if is_active %}
            <hr class="dropdown-divider">
            <button
                type="button"
                class="btn btn-sm btn-link text-danger p-0 w-100 text-start text-decoration-none"
                data-action="zhortein--datatable-bundle--datatable#clearFilter"
                data-zhortein--datatable-bundle--datatable-filter-param="{{ filter.name }}"
            >
                {{ 'zhortein_datatable.filters.clear'|trans({}, 'zhortein_datatable') }}
            </button>
        {% endif %}
    </div>
</div>
