<thead data-zhortein--datatable-bundle--datatable-target="header">
    <tr>
        {% if hasChildDatatable|default(false) %}<th scope="col"></th>{% endif %}
        {% if hasBulkActions|default(false) %}
            <th scope="col">
                <input
                    type="checkbox"
                    data-zhortein--datatable-bundle--datatable-target="selectAllCheckbox"
                    data-action="zhortein--datatable-bundle--datatable#selectAll"
                    aria-label="{{ 'zhortein_datatable.bulk_actions.select_all'|trans({}, 'zhortein_datatable') }}"
                >
            </th>
        {% endif %}
        {% for column in visibleColumns %}
            <th{% if columnClassNames[column.name]|default(null) %} class="{{ columnClassNames[column.name] }}"{% endif %} scope="col">
                {% if column.sortable %}
                    <button
                        type="button"
                        data-action="zhortein--datatable-bundle--datatable#sort"
                        data-zhortein--datatable-bundle--datatable-field-param="{{ column.name }}"
                        data-zhortein--datatable-bundle--datatable-current-sort-param="false"
                        data-zhortein--datatable-bundle--datatable-sort-direction-param=""
                    >
                        {{ zhortein_datatable_translate(column.label, definition.translationDomain, column.name) }}
                    </button>
                {% else %}
                    {{ zhortein_datatable_translate(column.label, definition.translationDomain, column.name) }}
                {% endif %}
            </th>
        {% endfor %}
        {% if hasRowActions %}<th scope="col">{{ 'zhortein_datatable.actions.label'|trans({}, 'zhortein_datatable') }}</th>{% endif %}
    </tr>
</thead>
