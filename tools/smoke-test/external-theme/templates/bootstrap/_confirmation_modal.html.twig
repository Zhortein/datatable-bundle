<dialog id="{{ htmlId }}_confirmation" data-zhortein--datatable-bundle--datatable-target="confirmationDialog">
    <p data-zhortein--datatable-bundle--datatable-target="confirmationMessage"></p>
    <button type="button" data-action="zhortein--datatable-bundle--datatable#cancelConfirmation">
        {{ 'zhortein_datatable.confirmation.cancel'|trans({}, 'zhortein_datatable') }}
    </button>
    <button type="button" data-action="zhortein--datatable-bundle--datatable#confirmPendingAction">
        {{ 'zhortein_datatable.confirmation.confirm'|trans({}, 'zhortein_datatable') }}
    </button>
</dialog>
