{
  "name": "zhortein/datatable-bundle",
  "description": "A Symfony 8+ bundle for Bootstrap-first business datatables driven by PHP definitions.",
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [
    {
      "name": "Zhortein",
      "homepage": "https://github.com/Zhortein"
    }
  ],
  "keywords": [
    "symfony",
    "bundle",
    "datatable",
    "bootstrap",
    "twig",
    "stimulus",
    "doctrine"
  ],
  "require": {
    "php": ">=8.4",
    "symfony/config": "^8.0",
    "symfony/dependency-injection": "^8.0",
    "symfony/http-kernel": "^8.0"
  },
  "require-dev": {
    "doctrine/orm": "^3.0 || ^4.0",
    "friendsofphp/php-cs-fixer": "^3.0",
    "friendsoftwig/twigcs": "^6.0",
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0",
    "symfony/framework-bundle": "^8.0",
    "symfony/twig-bundle": "^8.0"
  },
  "suggest": {
    "doctrine/orm": "Required to use Doctrine ORM backed datatables.",
    "symfony/stimulus-bundle": "Required to use the provided Stimulus controller integration.",
    "twig/twig": "Required to render datatables with Twig templates."
  },
  "autoload": {
    "psr-4": {
      "Zhortein\\DatatableBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Zhortein\\DatatableBundle\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix --diff",
    "twigcs": "twigcs templates",
    "qa": [
      "@test",
      "@phpstan",
      "@cs:check"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "extra": {
    "symfony": {
      "require": "8.0.*"
    }
  }
}
